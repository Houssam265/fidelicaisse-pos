<odoo>

    <record id="view_loyalty_member_list" model="ir.ui.view">
        <field name="name">loyalty.member.list</field>
        <field name="model">loyalty.member</field>
        <field name="arch" type="xml">
            <list string="Membres fidélité">
                <field name="partner_id"/>
                <field name="code_carte"/>
                <field name="solde_points"/>
                <field name="niveau"/>
                <field name="date_inscription"/>
            </list>
        </field>
    </record>

    <record id="view_loyalty_member_form" model="ir.ui.view">
        <field name="name">loyalty.member.form</field>
        <field name="model">loyalty.member</field>
        <field name="arch" type="xml">
            <form string="Membre fidélité">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="code_carte" readonly="1"/>
                            <field name="date_inscription"/>
                        </group>
                        <group>
                            <field name="solde_points" readonly="1"/>
                            <field name="niveau" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Historique des transactions">
                            <field name="transaction_ids">
                                <list>
                                    <field name="date"/>
                                    <field name="type"/>
                                    <field name="points"/>
                                    <field name="pos_order_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_loyalty_member" model="ir.actions.act_window">
        <field name="name">Membres fidélité</field>
        <field name="res_model">loyalty.member</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>