<odoo>
    <template id="page_carte" name="FideliCaisse - Ma carte de fidélité">
        <t t-call="web.layout">
            <t t-set="head">
                <title>Ma carte de fidélité</title>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <style>
                    body { font-family: Arial, sans-serif; background: #f4f2f3; margin: 0; }
                    .fc-wrap { max-width: 460px; margin: 60px auto; padding: 0 20px; }
                    .fc-card { background: #fff; border-radius: 10px; padding: 28px;
                               box-shadow: 0 2px 10px rgba(0,0,0,.08); }
                    h1 { color: #714B67; text-align: center; margin-top: 0; }
                    form { display: flex; gap: 10px; margin: 20px 0; }
                    input[type=text] { flex: 1; padding: 10px; font-size: 16px; text-transform: uppercase; }
                    button { padding: 10px 18px; background: #714B67; color: #fff; border: 0; border-radius: 4px; cursor: pointer; }
                    .fc-err { color: #c62828; }
                    .fc-points { font-size: 40px; font-weight: bold; color: #714B67; text-align: center; margin: 10px 0 0; }
                    .fc-badge { display: block; width: fit-content; margin: 8px auto; padding: 4px 14px;
                                border-radius: 12px; background: #714B67; color: #fff; text-transform: uppercase; font-size: 12px; }
                </style>
            </t>
            <div class="fc-wrap">
                <div class="fc-card">
                    <h1>Ma carte de fidélité</h1>
                    <form method="get" action="/fidelicaisse/carte">
                        <input type="text" name="code" placeholder="Code carte (8 caractères)"
                               t-att-value="code" maxlength="8" required="required"/>
                        <button type="submit">Consulter</button>
                    </form>
                    <p t-if="erreur" class="fc-err" t-out="erreur"/>
                    <t t-if="member">
                        <p style="text-align:center; margin-bottom:0;">
                            Bonjour <strong t-out="member.partner_id.name"/>
                        </p>
                        <p class="fc-points"><t t-out="member.solde_points"/> pts</p>
                        <span class="fc-badge" t-out="member.niveau"/>
                    </t>
                </div>
            </div>
        </t>
    </template>
</odoo>